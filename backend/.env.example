# Copy this file to .env and fill in real values before running locally.
# Never commit your actual .env file.

# MongoDB Atlas connection string (free M0 tier is sufficient).
# Get this from: Atlas dashboard -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/organbay?retryWrites=true&w=majority

# Any long random string -- used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# URL of the deployed (or local) FastAPI ML microservice.
ML_SERVICE_URL=http://localhost:8000

# Comma-separated list of allowed frontend origins for CORS + Socket.IO.
CORS_ORIGIN=http://localhost:5173

PORT=5000
